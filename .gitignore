# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.tox/

# Virtual Environments
venv/
env/
ENV/
.env

# Large raw datasets, downloads, and caches (>15 GB)
data/raw/tnk1_data/
**/_work/
*.sqlite
*.sqlite3
*.zip
*.tar.gz
*.tsv
*.tab
*.db
*.csv.gz
*.smi

# Large precomputed feature stores (>25 MB)
data/features/*.parquet
data/features/*.npz
data/features/*.csv
!data/features/README.md
!data/features/manifest.json
!data/features/*summary*.json
!data/features/*metadata*.json
!data/features/*splits*.json

# Model weights & binary checkpoints
*.pt
*.pth
*.pkl
*.bin
data/processed/
!data/processed/prior/*.toml
!data/processed/splits_v1.json
!data/raw/*.csv
!data/raw/README.md

# Structural models (AlphaFold & docking receptor)
!data/structures/*.pdb
!data/structures/*.pdbqt

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# Binaries and tools
*.exe
tools/

# Standalone execution and runner script files (consolidated into TNK1_Master_Pipeline.ipynb)
create_master_notebook.py
reorganize_project.py

# Logs and runtime outputs
*.log
**/*.log
runs/*.log

# Jupyter and testing checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/
oof_tmp*

# Orchestrator state and per-stage logs (scripts/run_pipeline.py)
runs/pipeline/
**/runs/pipeline/
**/logs/*.out
**/logs/*.err
**/logs/*.log

# Snapshot of the published Cycle-01 artifacts, kept locally for comparison
runs/cycle_01_published/
# Trained SMILES prior for rl_min (22 MB; rebuild with `make prior`)
data/processed/rl_min/
# Exact-environment lockfile IS tracked -- do not ignore requirements-lock.txt

# Virtual environments in subdirectories
envs/
**/envs/
**/venv/
**/env/

# Feature stores and processed binaries in subdirectories (e.g. TO_RUN_ON_GPU)
**/data/features/*.parquet
**/data/features/*.npz
**/data/features/*.csv
!**/data/features/README.md
!**/data/features/manifest.json
!**/data/features/*summary*.json
!**/data/features/*metadata*.json
